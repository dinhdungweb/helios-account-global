{% liquid
  assign history_dom_id = 'CardFlipHistory-' | append: section.id
  assign api_base_url = section.settings.api_base_url | strip
  assign campaign_id = section.settings.campaign_id | default: 'card-flip-2026' | strip
  assign history_limit = section.settings.history_limit | default: 0 | plus: 0
  assign max_customers = section.settings.max_customers | default: 1000 | plus: 0
  assign current_customer_id = ''
  if customer
    assign current_customer_id = customer.id
  endif
  assign scan_customers = section.settings.scan_customers
%}

<section
  id="{{ history_dom_id }}"
  class="card-flip-history"
  data-card-flip-history
  data-api-base="{{ api_base_url | escape }}"
  data-campaign-id="{{ campaign_id | escape }}"
  data-history-limit="{{ history_limit }}"
  data-max-customers="{{ max_customers }}"
  data-current-customer-id="{{ current_customer_id }}"
  data-scan-customers="{{ scan_customers }}"
  style="
    --cfh-bg: {{ section.settings.background_color }};
    --cfh-surface: {{ section.settings.surface_color }};
    --cfh-border: {{ section.settings.border_color }};
    --cfh-text: {{ section.settings.text_color }};
    --cfh-muted: {{ section.settings.muted_text_color }};
    --cfh-accent: {{ section.settings.accent_color }};
  "
>
  <div class="card-flip-history__wrap">
    <header class="card-flip-history__header">
      <div class="card-flip-history__header-content">
        {% if section.settings.heading != blank %}
          <h2 class="card-flip-history__title">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <div class="card-flip-history__copy">{{ section.settings.subheading }}</div>
        {% endif %}
      </div>

      <button class="card-flip-history__button card-flip-history__button--secondary card-flip-history__button--inventory" type="button" data-open-inventory>
        Quản lý kho thẻ
      </button>
    </header>

    <form class="card-flip-history__controls" data-history-form>
      <label class="card-flip-history__field">
        <span>Campaign ID</span>
        <input type="text" name="campaign_id" value="{{ campaign_id | escape }}" autocomplete="off" required>
      </label>

      <label class="card-flip-history__field card-flip-history__field--search">
        <span>Tìm kiếm</span>
        <input type="search" name="search" autocomplete="off" placeholder="Email, customer ID, kết quả, mã...">
      </label>

      <button class="card-flip-history__button" type="submit">{{ section.settings.load_button_text }}</button>
      <button class="card-flip-history__button card-flip-history__button--secondary" type="button" data-export-csv disabled>{{ section.settings.export_button_text }}</button>
      <button class="card-flip-history__button card-flip-history__button--danger" type="button" data-delete-history>{{ section.settings.delete_button_text }}</button>
    </form>

    <div class="card-flip-history__modal" data-inventory-modal aria-hidden="true">
      <div class="card-flip-history__modal-dialog" role="dialog" aria-modal="true" aria-labelledby="{{ history_dom_id }}-inventory-title">
        <button class="card-flip-history__modal-close" type="button" data-close-inventory aria-label="Đóng">
          <span aria-hidden="true">&times;</span>
        </button>

        <form class="card-flip-history__inventory" data-inventory-form>
          <div class="card-flip-history__inventory-heading">
            <strong id="{{ history_dom_id }}-inventory-title">Kho tất cả thẻ</strong>
            <span>Nhập tổng số lượng phát hành cho từng thẻ. Để trống nếu chưa muốn giới hạn.</span>
          </div>

          <div class="card-flip-history__inventory-grid">
            {% assign inventory_labels = 'chapter_i|CHAPTER I – ORIGIN,chapter_ii|CHAPTER II – THE FORGE,chapter_iii|CHAPTER III – DNA,chapter_iv|CHAPTER IV – THE ICONS,chapter_v|CHAPTER V – BEYOND JEWELRY,chapter_vi|CHAPTER VI – CROSSROADS,chapter_vii|CHAPTER VII – PEOPLE,chapter_viii|CHAPTER VIII – THE WEARERS,chapter_ix|CHAPTER IX – HEIRLOOM,chapter_x|CHAPTER X – FUTURE,chapter_xi|CHAPTER XI – THE OPENING,limited_card|LIMITED CARD' | split: ',' %}
            {% for inventory_item in inventory_labels %}
              {% assign inventory_parts = inventory_item | split: '|' %}
              <label class="card-flip-history__field">
                <span>{{ inventory_parts[1] }}</span>
                <input type="number" name="{{ inventory_parts[0] }}" data-inventory-key="{{ inventory_parts[0] }}" min="0" step="1" placeholder="Chưa giới hạn">
                <small data-inventory-stat="{{ inventory_parts[0] }}">Chưa giới hạn · Đã trúng: 0</small>
              </label>
            {% endfor %}
          </div>

          <div class="card-flip-history__inventory-actions">
            <button class="card-flip-history__button" type="submit" data-save-inventory>Lưu số lượng</button>
            <button class="card-flip-history__button card-flip-history__button--secondary" type="button" data-close-inventory>Hủy</button>
          </div>
        </form>
      </div>
    </div>

    <div class="card-flip-history__status" data-history-status role="status" aria-live="polite"></div>

    <div class="card-flip-history__stats" data-history-stats hidden>
      <div class="card-flip-history__stat">
        <span>Tổng lượt mở</span>
        <strong data-stat-total>0</strong>
      </div>
      <div class="card-flip-history__stat">
        <span>Khách tham gia</span>
        <strong data-stat-customers>0</strong>
      </div>
      <div class="card-flip-history__stat">
        <span>Đang hiển thị</span>
        <strong data-stat-visible>0</strong>
      </div>
      <div class="card-flip-history__stat">
        <span>Tối đa hiển thị</span>
        <strong data-stat-limit>0</strong>
      </div>
    </div>

    <div class="card-flip-history__table-wrap" data-history-table-wrap hidden>
      <table class="card-flip-history__table">
        <thead>
          <tr>
            <th>Thời gian</th>
            <th>Customer ID</th>
            <th>Email</th>
            <th>Mã đơn hàng</th>
            <th>Kết quả</th>
            <th>Mã</th>
            <th>Vị trí</th>
            <th>Ảnh</th>
          </tr>
        </thead>
        <tbody data-history-table></tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .card-flip-history {
    background: var(--cfh-bg);
    color: var(--cfh-text);
    padding: clamp(28px, 4vw, 56px) 16px;
  }

  .card-flip-history__wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0 auto;
    max-width: 1240px;
    width: 100%;
  }

  .card-flip-history__wrap > * {
    min-width: 0;
    width: 100%;
  }

  .card-flip-history__header {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    margin-bottom: 24px;
    text-align: left;
  }

  .card-flip-history__header-content {
    display: grid;
    flex: 1 1 260px;
    gap: 8px;
    min-width: 0;
  }

  .card-flip-history__title {
    color: var(--cfh-text);
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.15;
    margin: 0;
    text-align: left;
  }

  .card-flip-history__copy {
    color: var(--cfh-muted);
    line-height: 1.55;
  }

  .card-flip-history__controls {
    align-items: end;
    background: var(--cfh-surface);
    border: 1px solid var(--cfh-border);
    border-radius: 8px;
    box-sizing: border-box;
    clear: both;
    display: grid !important;
    float: none !important;
    gap: 12px;
    grid-template-columns: 1fr;
    max-width: none !important;
    margin-bottom: 16px;
    padding: 14px;
    width: 100% !important;
  }

  .card-flip-history__field {
    box-sizing: border-box;
    display: grid;
    gap: 6px;
    min-width: 0;
  }

  .card-flip-history__field span {
    color: var(--cfh-muted);
    font-size: 13px;
    line-height: 1.2;
  }

  .card-flip-history__field input {
    background: var(--cfh-surface);
    border: 1px solid var(--cfh-border);
    border-radius: 6px;
    box-sizing: border-box;
    color: var(--cfh-text);
    display: block !important;
    font: inherit;
    letter-spacing: 0;
    margin: 0 !important;
    max-width: none !important;
    min-height: 44px;
    min-width: 0;
    padding: 10px 12px;
    text-transform: none;
    width: 100%;
  }

  .card-flip-history__button {
    align-items: center;
    background: var(--cfh-accent);
    border: 1px solid var(--cfh-accent);
    border-radius: 6px;
    box-sizing: border-box;
    color: #111;
    cursor: pointer;
    display: inline-flex !important;
    font-weight: 700;
    justify-content: center;
    letter-spacing: 0;
    line-height: 1.2;
    margin: 0 !important;
    min-height: 44px;
    min-width: 116px;
    padding: 10px 16px;
    text-align: center;
    text-transform: none;
    white-space: nowrap;
    width: 100%;
  }

  .card-flip-history__button--secondary {
    background: transparent;
    color: var(--cfh-text);
  }

  .card-flip-history__button--danger {
    background: #b42318;
    border-color: #b42318;
    color: #fff;
  }

  .card-flip-history__button:disabled {
    cursor: default;
    opacity: 0.48;
  }

  .card-flip-history__button--inventory {
    flex: 0 0 auto;
    margin-left: auto !important;
    min-width: 170px;
    width: auto;
  }

  .card-flip-history__modal {
    align-items: center;
    background: rgba(0, 0, 0, 0.76);
    display: flex;
    inset: 0;
    justify-content: center;
    opacity: 0;
    padding: 20px;
    pointer-events: none;
    position: fixed;
    transition: opacity 180ms ease, visibility 180ms ease;
    visibility: hidden;
    z-index: 9999;
  }

  .card-flip-history__modal.is-open {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  .card-flip-history__modal-dialog {
    background: var(--cfh-surface);
    border: 1px solid var(--cfh-border);
    border-radius: 10px;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.55);
    max-height: calc(100vh - 40px);
    max-height: calc(100dvh - 40px);
    max-width: 1180px;
    overflow: auto;
    overscroll-behavior: contain;
    position: relative;
    transform: translateY(12px) scale(0.985);
    transition: transform 180ms ease;
    width: 100%;
  }

  .card-flip-history__modal.is-open .card-flip-history__modal-dialog {
    transform: translateY(0) scale(1);
  }

  .card-flip-history__modal-close {
    align-items: center;
    background: transparent;
    border: 0;
    color: var(--cfh-text);
    cursor: pointer;
    display: flex;
    font-size: 30px;
    height: 44px;
    justify-content: center;
    line-height: 1;
    padding: 0;
    position: absolute;
    right: 10px;
    top: 8px;
    width: 44px;
    z-index: 1;
  }

  .card-flip-history__inventory {
    align-items: end;
    display: grid;
    gap: 12px;
    grid-template-columns: 1fr;
    padding: 24px;
  }

  .card-flip-history__inventory-heading {
    display: grid;
    gap: 4px;
    padding-right: 44px;
  }

  .card-flip-history__inventory-grid {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  }

  .card-flip-history__inventory-heading strong {
    color: var(--cfh-text);
    font-size: 20px;
  }

  .card-flip-history__inventory-actions {
    display: flex;
    gap: 10px;
    margin-top: 4px;
  }

  .card-flip-history__inventory-heading span,
  .card-flip-history__field small {
    color: var(--cfh-muted);
    font-size: 12px;
  }

  .card-flip-history__status {
    color: var(--cfh-muted);
    min-height: 22px;
    margin: 10px 0 16px;
  }

  .card-flip-history__stats {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-bottom: 16px;
  }

  .card-flip-history__stat {
    background: var(--cfh-surface);
    border: 1px solid var(--cfh-border);
    border-radius: 8px;
    display: grid;
    gap: 6px;
    min-height: 82px;
    padding: 14px;
  }

  .card-flip-history__stat span {
    color: var(--cfh-muted);
    font-size: 13px;
  }

  .card-flip-history__stat strong {
    color: var(--cfh-accent);
    font-size: 22px;
    line-height: 1.1;
    overflow-wrap: anywhere;
  }

  .card-flip-history__table-wrap {
    background: var(--cfh-surface);
    border: 1px solid var(--cfh-border);
    border-radius: 8px;
    overflow-x: auto;
  }

  .card-flip-history__table {
    border-collapse: collapse;
    min-width: 1120px;
    width: 100%;
  }

  .card-flip-history__table th,
  .card-flip-history__table td {
    border-bottom: 1px solid var(--cfh-border);
    padding: 12px;
    text-align: left;
    vertical-align: middle;
  }

  .card-flip-history__table th {
    color: var(--cfh-muted);
    font-size: 13px;
    font-weight: 700;
  }

  .card-flip-history__table tr:last-child td {
    border-bottom: 0;
  }

  .card-flip-history__thumb {
    aspect-ratio: 3 / 4;
    background: #222;
    border-radius: 4px;
    display: block;
    height: 62px;
    object-fit: cover;
    width: 46px;
  }

  .card-flip-history__empty {
    color: var(--cfh-muted);
    padding: 18px;
    text-align: center;
  }

  @media (min-width: 960px) {
    .card-flip-history__controls {
      grid-template-columns: minmax(180px, 260px) minmax(320px, 1fr) 120px 120px 120px;
    }

    .card-flip-history__button {
      width: 120px;
    }

    .card-flip-history__button--inventory {
      width: auto;
    }

    .card-flip-history__inventory {
      grid-template-columns: 1fr;
    }

    .card-flip-history__inventory .card-flip-history__button {
      width: 140px;
    }
  }

  @media (max-width: 720px) {
    .card-flip-history__modal {
      align-items: flex-end;
      padding: 10px;
    }

    .card-flip-history__modal-dialog {
      border-radius: 10px 10px 0 0;
      max-height: calc(100vh - 10px);
      max-height: calc(100dvh - 10px);
    }

    .card-flip-history__inventory {
      padding: 18px 14px;
    }

    .card-flip-history__inventory-grid {
      grid-template-columns: 1fr;
    }

    .card-flip-history__inventory-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .card-flip-history__stats {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  (function () {
    const root = document.getElementById({{ history_dom_id | json }});
    if (!root || root.dataset.historyInitialized === 'true') return;
    root.dataset.historyInitialized = 'true';

    const form = root.querySelector('[data-history-form]');
    const status = root.querySelector('[data-history-status]');
    const stats = root.querySelector('[data-history-stats]');
    const tableWrap = root.querySelector('[data-history-table-wrap]');
    const tableBody = root.querySelector('[data-history-table]');
    const exportButton = root.querySelector('[data-export-csv]');
    const deleteButton = root.querySelector('[data-delete-history]');
    const searchInput = form.querySelector('[name="search"]');
    const inventoryForm = root.querySelector('[data-inventory-form]');
    const saveInventoryButton = root.querySelector('[data-save-inventory]');
    const inventoryModal = root.querySelector('[data-inventory-modal]');
    const openInventoryButton = root.querySelector('[data-open-inventory]');
    const closeInventoryButtons = root.querySelectorAll('[data-close-inventory]');

    const config = {
      apiBase: normalizeApiBase(root.dataset.apiBase || ''),
      defaultCampaignId: root.dataset.campaignId || 'card-flip-2026',
      limit: toInt(root.dataset.historyLimit, 0),
      maxCustomers: toInt(root.dataset.maxCustomers, 1000),
      currentCustomerId: root.dataset.currentCustomerId || '',
      scanCustomers: root.dataset.scanCustomers === 'true',
      loadingText: {{ section.settings.loading_text | json }},
      emptyText: {{ section.settings.empty_text | json }},
      errorText: {{ section.settings.error_text | json }},
      deletePromptText: {{ section.settings.delete_prompt_text | json }},
      deleteConfirmText: {{ section.settings.delete_confirm_text | json }},
      deleteLoadingText: {{ section.settings.delete_loading_text | json }},
      deleteSuccessText: {{ section.settings.delete_success_text | json }},
      deletePasswordRequiredText: {{ section.settings.delete_password_required_text | json }}
    };

    let currentRows = [];
    let visibleRows = [];
    let lastSummary = null;
    let previousBodyOverflow = '';

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      loadHistory();
      loadInventory();
    });

    searchInput.addEventListener('input', renderTable);
    exportButton.addEventListener('click', exportCsv);
    deleteButton.addEventListener('click', deleteHistory);
    inventoryForm.addEventListener('submit', saveInventory);
    openInventoryButton.addEventListener('click', openInventoryModal);
    closeInventoryButtons.forEach(function (button) {
      button.addEventListener('click', closeInventoryModal);
    });
    inventoryModal.addEventListener('click', function (event) {
      if (event.target === inventoryModal) closeInventoryModal();
    });
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && inventoryModal.classList.contains('is-open')) {
        closeInventoryModal();
      }
    });

    applyQueryParams();
    loadHistory();
    loadInventory();

    function openInventoryModal() {
      loadInventory();
      previousBodyOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      inventoryModal.classList.add('is-open');
      inventoryModal.setAttribute('aria-hidden', 'false');

      window.setTimeout(function () {
        const closeButton = inventoryModal.querySelector('.card-flip-history__modal-close');
        if (closeButton) closeButton.focus();
      }, 0);
    }

    function closeInventoryModal() {
      inventoryModal.classList.remove('is-open');
      inventoryModal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = previousBodyOverflow;
      openInventoryButton.focus();
    }

    function applyQueryParams() {
      const params = new URLSearchParams(window.location.search);
      const campaignId = params.get('campaign_id');
      if (campaignId) {
        form.elements.campaign_id.value = campaignId;
      }
    }

    async function loadHistory() {
      const campaignId = form.elements.campaign_id.value.trim() || config.defaultCampaignId;

      if (!config.apiBase) {
        setStatus(config.errorText);
        return;
      }

      setStatus(config.loadingText);
      exportButton.disabled = true;
      tableBody.innerHTML = '';
      tableWrap.hidden = true;

      const params = new URLSearchParams({
        campaign_id: campaignId,
        max_customers: String(config.maxCustomers)
      });
      if (config.limit > 0) {
        params.set('limit', String(config.limit));
      } else {
        params.set('limit', 'all');
      }
      if (config.currentCustomerId) {
        params.set('include_customer_id', config.currentCustomerId);
      }
      if (config.scanCustomers) {
        params.set('scan_customers', 'true');
      }

      try {
        const response = await fetch(config.apiBase + '/card-flip/history?' + params.toString(), {
          method: 'GET',
          cache: 'no-store'
        });
        const data = await response.json();

        if (!response.ok || !data.success) {
          throw new Error(data.error || config.errorText);
        }

        currentRows = Array.isArray(data.history) ? data.history : [];
        lastSummary = data;
        renderTable();
        setStatus(getSummaryStatus(data));
      } catch (error) {
        currentRows = [];
        visibleRows = [];
        lastSummary = null;
        stats.hidden = true;
        tableWrap.hidden = true;
        setStatus(error.message || config.errorText);
      }
    }

    function updateStats() {
      stats.hidden = false;
      root.querySelector('[data-stat-total]').textContent = lastSummary ? lastSummary.total_entries || 0 : 0;
      root.querySelector('[data-stat-customers]').textContent = lastSummary ? lastSummary.unique_customers || 0 : 0;
      root.querySelector('[data-stat-visible]').textContent = visibleRows.length;
      root.querySelector('[data-stat-limit]').textContent = getDisplayLimit();
    }

    function renderTable() {
      const search = searchInput.value.trim().toLowerCase();
      visibleRows = currentRows.filter(function (row) {
        if (!search) return true;
        return [
          row.customer_id,
          row.customer_email,
          formatOrderNames(row.customer_order_names),
          row.card_title,
          row.result_title,
          row.card_code,
          row.result_code,
          row.campaign_id,
          row.played_at
        ].some(function (value) {
          return String(value || '').toLowerCase().includes(search);
        });
      });

      tableBody.innerHTML = '';
      tableWrap.hidden = false;
      exportButton.disabled = visibleRows.length === 0;

      if (!visibleRows.length) {
        const row = document.createElement('tr');
        const cell = document.createElement('td');
        cell.colSpan = 8;
        cell.className = 'card-flip-history__empty';
        cell.textContent = config.emptyText;
        row.appendChild(cell);
        tableBody.appendChild(row);
        updateStats();
        return;
      }

      visibleRows.forEach(function (entry) {
        const row = document.createElement('tr');
        addCell(row, formatDate(entry.played_at));
        addCell(row, entry.customer_id || '-');
        addCell(row, entry.customer_email || '-');
        addCell(row, formatOrderNames(entry.customer_order_names));
        addCell(row, entry.result_title || entry.card_title || '-');
        addCell(row, entry.result_code || entry.card_code || '-');
        addCell(row, formatPosition(entry));
        addImageCell(row, entry.result_image || entry.card_image || '', entry.result_title || entry.card_title || '');
        tableBody.appendChild(row);
      });

      updateStats();
    }

    function addCell(row, value) {
      const cell = document.createElement('td');
      cell.textContent = value;
      row.appendChild(cell);
    }

    function formatOrderNames(value, separator) {
      const orderNames = Array.isArray(value) ? value.filter(Boolean) : [];
      return orderNames.length ? orderNames.join(separator || ', ') : '-';
    }

    function addImageCell(row, src, alt) {
      const cell = document.createElement('td');
      if (src) {
        const image = document.createElement('img');
        image.className = 'card-flip-history__thumb';
        image.width = 46;
        image.height = 62;
        image.loading = 'lazy';
        image.src = src;
        image.alt = alt;
        cell.appendChild(image);
      } else {
        cell.textContent = '-';
      }
      row.appendChild(cell);
    }

    function exportCsv() {
      if (!visibleRows.length) return;

      const headers = ['played_at', 'customer_id', 'customer_email', 'customer_order_names', 'campaign_id', 'card_title', 'card_code', 'card_position', 'deck_size'];
      const lines = [headers.join(',')].concat(visibleRows.map(function (row) {
        return headers.map(function (key) {
          const value = key === 'customer_order_names'
            ? formatOrderNames(row[key], ' | ')
            : row[key] || '';
          return csvValue(value);
        }).join(',');
      }));

      const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      const campaignId = form.elements.campaign_id.value.trim() || 'campaign';
      link.href = url;
      link.download = 'card-flip-history-' + campaignId + '.csv';
      document.body.appendChild(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
    }

    async function loadInventory() {
      const campaignId = form.elements.campaign_id.value.trim() || config.defaultCampaignId;
      if (!config.apiBase) return;

      try {
        const params = new URLSearchParams({ campaign_id: campaignId });
        const response = await fetch(config.apiBase + '/card-flip/inventory?' + params.toString(), {
          method: 'GET',
          cache: 'no-store'
        });
        const data = await response.json();

        if (!response.ok || !data.success) {
          throw new Error(data.error || config.errorText);
        }

        renderInventory(data.cards);
      } catch (error) {
        setStatus(error.message || config.errorText);
      }
    }

    function renderInventory(cards) {
      (Array.isArray(cards) ? cards : []).forEach(function (card) {
        const input = inventoryForm.elements[card.key];
        const stat = root.querySelector('[data-inventory-stat="' + card.key + '"]');
        if (input) input.value = card.managed === false ? '' : toInt(card.capacity, 0);
        if (stat) {
          stat.textContent = card.managed === false
            ? 'Chưa giới hạn · Đã trúng: ' + toInt(card.claimed, 0)
            : 'Đã trúng: ' + toInt(card.claimed, 0) + ' · Còn lại: ' + toInt(card.remaining, 0);
        }
      });
    }

    async function saveInventory(event) {
      event.preventDefault();
      const campaignId = form.elements.campaign_id.value.trim() || config.defaultCampaignId;
      const password = window.prompt('Nhập mật khẩu quản trị để cập nhật kho thẻ');
      if (password === null) return;
      if (!password.trim()) {
        setStatus(config.deletePasswordRequiredText);
        return;
      }

      saveInventoryButton.disabled = true;
      setStatus('Đang cập nhật kho thẻ...');

      try {
        const capacities = {};
        inventoryForm.querySelectorAll('[data-inventory-key]').forEach(function (input) {
          const value = input.value.trim();
          if (value !== '') capacities[input.dataset.inventoryKey] = toInt(value, 0);
        });

        const response = await fetch(config.apiBase + '/card-flip/inventory', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          cache: 'no-store',
          body: JSON.stringify({
            campaign_id: campaignId,
            password: password,
            capacities: capacities
          })
        });
        const data = await response.json();

        if (!response.ok || !data.success) {
          throw new Error(data.error || config.errorText);
        }

        renderInventory(data.cards);
        setStatus('Đã cập nhật kho tất cả thẻ.');
        closeInventoryModal();
      } catch (error) {
        setStatus(error.message || config.errorText);
      } finally {
        saveInventoryButton.disabled = false;
      }
    }

    async function deleteHistory() {
      const campaignId = form.elements.campaign_id.value.trim() || config.defaultCampaignId;
      const customerIds = Array.from(new Set(
        currentRows
          .map(function (row) { return String(row.customer_id || '').replace(/\D/g, ''); })
          .filter(Boolean)
          .concat(config.currentCustomerId ? [String(config.currentCustomerId).replace(/\D/g, '')] : [])
      )).filter(Boolean);
      if (!config.apiBase) {
        setStatus(config.errorText);
        return;
      }

      const password = window.prompt(config.deletePromptText);
      if (password === null) return;
      if (!password.trim()) {
        setStatus(config.deletePasswordRequiredText);
        return;
      }

      if (!window.confirm(config.deleteConfirmText.replace('[campaign]', campaignId))) {
        return;
      }

      setStatus(config.deleteLoadingText);
      deleteButton.disabled = true;
      exportButton.disabled = true;

      try {
        const response = await fetch(config.apiBase + '/card-flip/delete-history', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          cache: 'no-store',
          body: JSON.stringify({
            campaign_id: campaignId,
            password: password,
            customer_ids: customerIds
          })
        });
        const data = await response.json();

        if (!response.ok || !data.success) {
          throw new Error(data.error || config.errorText);
        }

        searchInput.value = '';
        await loadHistory();
        await loadInventory();
        setStatus(
          config.deleteSuccessText
            .replace('[count]', data.deleted_entries || 0)
            .replace('[customers]', data.updated_customers || 0)
        );
      } catch (error) {
        setStatus(error.message || config.errorText);
      } finally {
        deleteButton.disabled = false;
      }
    }

    function getSummaryStatus(data) {
      if (!currentRows.length) return config.emptyText;
      if (data.is_limited) {
        return 'Đang hiển thị ' + currentRows.length + ' / ' + data.total_entries + ' lượt.';
      }
      if (data.has_more_customers && data.scanned_customers) {
        return 'Đang hiển thị ' + currentRows.length + ' lượt gần nhất trong ' + data.scanned_customers + ' khách đã quét.';
      }
      return '';
    }

    function getDisplayLimit() {
      if (!lastSummary) return config.limit > 0 ? config.limit : 'Tất cả';
      if (lastSummary.limit === 'all' || lastSummary.limit === 0) return 'Tất cả';
      return lastSummary.limit || (config.limit > 0 ? config.limit : 'Tất cả');
    }

    function csvValue(value) {
      return '"' + String(value).replace(/"/g, '""') + '"';
    }

    function formatPosition(entry) {
      const position = entry.card_position || '-';
      const deckSize = entry.deck_size || '-';
      return position + '/' + deckSize;
    }

    function formatDate(value) {
      if (!value) return '-';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return value;
      return date.toLocaleString('vi-VN', {
        hour12: false,
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        hour: '2-digit',
        minute: '2-digit'
      });
    }

    function setStatus(message) {
      status.textContent = message || '';
    }

    function toInt(value, fallback) {
      const number = parseInt(value, 10);
      return Number.isFinite(number) ? number : fallback;
    }

    function normalizeApiBase(value) {
      return String(value || '').replace(/\/+$/, '');
    }
  })();
</script>

