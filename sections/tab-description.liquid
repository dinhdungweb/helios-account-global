{% assign zero = "0" %}
<div class="product-tabs wide-container">
  <ul class="tab-list">
    <li class="tab-item active" data-tab="description">
      Description</li>
    <li class="tab-item" data-tab="reviews">
      Reviews ({% if product.metafields.reviews.rating_count > 0 %}
                  {{ product.metafields.reviews.rating_count }}
                {% else %}
                  {{ zero }}
                {% endif %})
    </li>
  </ul>
  
  <div class="tab-content">
    <div id="description" class="tab-pane active">
      <div class="description-content">
            {{ product.description }}
      </div>
      <div id="toggle-description" class="btn-toggle">
        <div class="a-bar">View more {% render "svg-chevron-down" %}</div>
      </div>
    </div>

    
    <div id="reviews" class="tab-pane">
        <div style='clear:both'></div> 
        <div id='judgeme_product_reviews' class='jdgm-widget jdgm-review-widget' data-id='{{ product.id }}'> 
          {{ product.metafields.judgeme.widget }} 
        </div> 
    </div>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .product-tabs {
    max-width: 1300px;
    padding-top: 16px !important;
  }

  #shopify-section-{{ section.id }} .tab-list {
    display: flex;
    justify-content: center;
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .tab-item {
    min-height: 0;
    padding: 12px 0 10px;
    border: 0;
    border-bottom: 2px solid transparent;
    border-radius: 0;
    background: transparent;
    color: inherit;
    font-size: 1.125rem;
    font-weight: 500;
    opacity: 0.65;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .tab-item.active {
    border-bottom-color: #fff;
    background: transparent;
    color: inherit;
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .tab-content {
    padding: 24px 0 40px;
  }
</style>

{% schema %}
  {
    "name": "Tabs Product Description",
    "settings": [],
    "presets": [
    {
      "name": "Tabs Product Description",
      "settings": {
      },
      "blocks": []
    }
  ]
  }
{% endschema %}
