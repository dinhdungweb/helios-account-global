{%- liquid
  assign show_blog_filters = false
  if blog.all_tags.size > 0 and section.settings.blog_show_filter
    assign show_blog_filters = true
  endif
-%}

<div class="helios-blog-wrapper" data-section-id="{{ section.id }}" data-section-type="blog-template">
  <header class="blog-page-header">
    {% if section.settings.blog_show_title %}
      <h1 class="blog-page-header__title">{{ blog.title }}</h1>
    {% endif %}

    <nav class="blog-page-header__nav" aria-label="Blog navigation">
      {% if section.settings.blog_navigation != blank %}
        {% for link in section.settings.blog_navigation.links %}
          <a
            href="{{ link.url }}"
            class="blog-page-header__link{% if link.current %} is-active{% endif %}"
            {% if link.current %}aria-current="page"{% endif %}
          >
            {{ link.title }}
          </a>
        {% endfor %}
      {% else %}
        {%- liquid
          assign nav_handles = 'world-of-helios,nhan,day-chuyen,vong-tay,bac,da,kinh' | split: ','
        -%}
        {% for handle in nav_handles %}
          {% assign nav_blog = blogs[handle] %}
          {% if nav_blog != blank %}
            <a
              href="{{ nav_blog.url }}"
              class="blog-page-header__link{% if blog.handle == handle %} is-active{% endif %}"
              {% if blog.handle == handle %}aria-current="page"{% endif %}
            >
              {{ nav_blog.title }}
            </a>
          {% endif %}
        {% endfor %}
      {% endif %}
    </nav>
  </header>

  {% if show_blog_filters %}
    <div class="blog-page-filter">
      <label for="BlogFilter-{{ section.id }}">{{ 'blogs.filtering.filter' | t }}</label>
      <select id="BlogFilter-{{ section.id }}" class="redirecter">
        <option value="{{ blog.url }}">{{ 'blogs.filtering.all' | t }}</option>
        {% for tag in blog.all_tags %}
          <option value="{{ blog.url }}/tagged/{{ tag | handle }}"{% if current_tags contains tag %} selected{% endif %}>
            {{ tag | capitalize }}
          </option>
        {% endfor %}
      </select>
    </div>
  {% endif %}

  {% paginate blog.articles by section.settings.blog_posts_per_page %}
    <div class="helios-banner-stack">
      {% for article in blog.articles %}
        {% assign article_index = forloop.index %}
        {% render 'blog-card', article: article %}

        {% for block in section.blocks %}
          {% if block.settings.insert_after == article_index %}
            <section class="helios-blog-banner in-feed-banner" {{ block.shopify_attributes }}>
              {% if block.type == 'banner_image' and block.settings.image != blank %}
                <div class="banner__media">
                  {{
                    block.settings.image
                    | image_url: width: 2000
                    | image_tag:
                      widths: '600, 900, 1200, 1600, 2000',
                      sizes: '100vw',
                      loading: 'lazy',
                      class: 'banner__image',
                      alt: block.settings.title
                  }}
                </div>
              {% elsif block.type == 'banner_video' and block.settings.video != blank %}
                <div class="banner__media">
                  {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'banner__video' }}
                </div>
              {% endif %}

              <div class="banner__content">
                {% if block.settings.sub_title != blank %}
                  <div class="banner__title--small">{{ block.settings.sub_title }}</div>
                {% endif %}
                {% if block.settings.title != blank %}
                  <div class="banner__highlight">{{ block.settings.title }}</div>
                {% endif %}
                {% if block.settings.link_text != blank %}
                  <a href="{{ block.settings.link_url | default: '#' }}" class="banner__link">{{ block.settings.link_text }}</a>
                {% endif %}
              </div>
            </section>
          {% endif %}
        {% endfor %}
      {% else %}
        <p class="align-centre blog-page-empty"><em>{{ 'blogs.general.no_matches' | t }}</em></p>
      {% endfor %}
    </div>

    {% if paginate.pages > 1 %}
      <div class="pagination-container blog-page-pagination">
        <div class="pagination central content">
          {% assign older_articles = 'blogs.pagination.older_articles' | t %}
          {% assign newer_articles = 'blogs.pagination.newer_articles' | t %}
          {{ paginate | default_pagination | replace: 'Previous', newer_articles | replace: 'Next', older_articles }}
        </div>
      </div>
    {% endif %}
  {% endpaginate %}

</div>

{% render 'blog-styles-helper' %}

{% schema %}
{
  "name": "Blog pages",
  "settings": [
    {
      "type": "link_list",
      "id": "blog_navigation",
      "label": "Blog navigation"
    },
    {
      "type": "range",
      "id": "blog_posts_per_page",
      "label": "Posts per page",
      "min": 6,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "blog_show_title",
      "label": "Show page title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "blog_show_filter",
      "label": "Show tag filter",
      "default": false
    },
    {
      "type": "select",
      "id": "blog_layout",
      "label": "Legacy layout setting",
      "options": [
        { "value": "collage", "label": "Collage" },
        { "value": "rows", "label": "Grid" }
      ],
      "default": "collage",
      "info": "Kept for compatibility with existing Global templates."
    },
    {
      "type": "select",
      "id": "blog_posts_per_row_mobile",
      "label": "Legacy mobile columns",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2",
      "info": "Kept for compatibility with existing Global templates."
    },
    {
      "type": "checkbox",
      "id": "blog_show_rss_link",
      "label": "Legacy RSS setting",
      "default": false,
      "info": "Kept for compatibility with existing Global templates."
    }
  ],
  "blocks": [
    {
      "type": "banner_image",
      "name": "In-feed banner image",
      "settings": [
        { "type": "number", "id": "insert_after", "label": "Insert after post number", "default": 3 },
        { "type": "image_picker", "id": "image", "label": "Banner image" },
        { "type": "text", "id": "sub_title", "label": "Sub title", "default": "PROMOTION" },
        { "type": "text", "id": "title", "label": "Main title", "default": "Special Offer for Helios Members" },
        { "type": "text", "id": "link_text", "label": "Link text", "default": "DISCOVER NOW" },
        { "type": "url", "id": "link_url", "label": "Link URL" }
      ]
    },
    {
      "type": "banner_video",
      "name": "In-feed banner video",
      "settings": [
        { "type": "number", "id": "insert_after", "label": "Insert after post number", "default": 3 },
        { "type": "video", "id": "video", "label": "Video" },
        { "type": "text", "id": "sub_title", "label": "Sub title", "default": "STORY" },
        { "type": "text", "id": "title", "label": "Main title", "default": "The Art of Jewelry Making" },
        { "type": "text", "id": "link_text", "label": "Link text", "default": "WATCH STORY" },
        { "type": "url", "id": "link_url", "label": "Link URL" }
      ]
    }
  ]
}
{% endschema %}
