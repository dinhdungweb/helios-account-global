{% style %}
  .before-after-container-{{ section.id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    user-select: none;
    touch-action: pan-y;
  }

  .before-after__wrapper {
    position: relative;
    aspect-ratio: {{ section.settings.aspect_ratio | default: '16/9' }};
    width: 100%;
    margin: 0 auto;
    max-width: {{ section.settings.max_width }}px;
  }

  .before-after__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .before-after__image--after {
    z-index: 1;
  }

  .before-after__image--before {
    z-index: 2;
    clip-path: inset(0 calc(100% - var(--slider-pos, 50%)) 0 0);
  }

  .before-after__slider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--slider-pos, 50%);
    width: 2px;
    background: #fff;
    z-index: 3;
    pointer-events: none;
    transform: translateX(-50%);
  }

  .before-after__handle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 40px;
    height: 40px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 0 10px rgba(0,0,0,0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: ew-resize;
    pointer-events: auto;
  }

  .before-after__handle::before,
  .before-after__handle::after {
    content: '';
    width: 0;
    height: 0;
    border-style: solid;
  }

  .before-after__handle::before {
    border-width: 6px 8px 6px 0;
    border-color: transparent #333 transparent transparent;
    margin-right: 4px;
  }

  .before-after__handle::after {
    border-width: 6px 0 6px 8px;
    border-color: transparent transparent transparent #333;
    margin-left: 4px;
  }

  .before-after__input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: ew-resize;
    z-index: 4;
    margin: 0;
  }

  .before-after__label {
    position: absolute;
    bottom: 20px;
    padding: 5px 15px;
    background: rgba(0,0,0,0.5);
    color: #fff;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    z-index: 3;
    pointer-events: none;
  }

  .before-after__label--before {
    left: 20px;
  }

  .before-after__label--after {
    right: 20px;
  }

  #section-id-{{ section.id }} {
    {% if section.settings.color_scheme == 'custom' %}
      background: {{ section.settings.color_bg }};
      color: {{ section.settings.color_text }};
    {% endif %}
  }
{% endstyle %}

<div id="section-id-{{ section.id }}" class="before-after-section use-{{ section.settings.color_scheme }}-bg padded-block" data-section-id="{{ section.id }}" data-section-type="before-after">
  <div class="container">
    {% if section.settings.title != blank %}
      <h2 class="h2 align-center feature-header" data-cc-animate="cc-fade-in-up">
        {{ section.settings.title }}
      </h2>
    {% endif %}
    {% if section.settings.subtitle != blank %}
      <div class="rte align-center" data-cc-animate="cc-fade-in-up" data-cc-animate-delay="0.1s">
        {{ section.settings.subtitle }}
      </div>
    {% endif %}

    <div class="before-after__wrapper before-after-container-{{ section.id }}" data-cc-animate="cc-fade-in" data-cc-animate-delay="0.2s">
      {%- if section.settings.image_after != blank -%}
        <img class="before-after__image before-after__image--after" 
             src="{{ section.settings.image_after | img_url: '1600x' }}" 
             alt="{{ section.settings.image_after.alt | escape }}"
             loading="lazy">
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'before-after__image before-after__image--after placeholder-svg' }}
      {%- endif -%}

      {%- if section.settings.image_before != blank -%}
        <img class="before-after__image before-after__image--before" 
             src="{{ section.settings.image_before | img_url: '1600x' }}" 
             alt="{{ section.settings.image_before.alt | escape }}"
             loading="lazy">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'before-after__image before-after__image--before placeholder-svg' }}
      {%- endif -%}

      <div class="before-after__slider">
        <div class="before-after__handle"></div>
      </div>

      {% if section.settings.label_before != blank %}
        <div class="before-after__label before-after__label--before">{{ section.settings.label_before }}</div>
      {% endif %}
      {% if section.settings.label_after != blank %}
        <div class="before-after__label before-after__label--after">{{ section.settings.label_after }}</div>
      {% endif %}

      <input type="range" min="0" max="100" value="50" class="before-after__input" aria-label="Percentage of before image shown">
    </div>
  </div>
</div>

<script>
  (function() {
    const initBeforeAfter = () => {
      const containers = document.querySelectorAll('.before-after-container-{{ section.id }}');
      containers.forEach(container => {
        const input = container.querySelector('.before-after__input');
        
        const updateSlider = () => {
          container.style.setProperty('--slider-pos', input.value + '%');
        };

        input.addEventListener('input', updateSlider);
        
        // Initial set
        updateSlider();
      });
    };

    // Run on load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBeforeAfter);
    } else {
      initBeforeAfter();
    }

    // Support for Theme Editor
    document.addEventListener('shopify:section:load', (e) => {
      if (e.detail.sectionId === '{{ section.id }}') {
        initBeforeAfter();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Before/After Image",
  "class": "section-before-after",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Before and After"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_before",
      "label": "Before Image"
    },
    {
      "type": "text",
      "id": "label_before",
      "label": "Before Label",
      "default": "Before"
    },
    {
      "type": "image_picker",
      "id": "image_after",
      "label": "After Image"
    },
    {
      "type": "text",
      "id": "label_after",
      "label": "After Label",
      "default": "After"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 400,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Maximum width",
      "default": 1000
    },
    {
      "type": "text",
      "id": "aspect_ratio",
      "label": "Aspect Ratio (e.g. 16/9, 4/3)",
      "default": "16/9"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "alt",
          "label": "Alternate colors"
        },
        {
          "value": "custom",
          "label": "Custom colors"
        }
      ]
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Custom background color"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Custom text color"
    }
  ],
  "presets": [
    {
      "name": "Before/After Image"
    }
  ]
}
{% endschema %}
