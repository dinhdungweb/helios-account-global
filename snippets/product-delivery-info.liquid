{%- liquid
  assign delivery_block_id = 'delivery-info-' | append: section.id | append: '-' | append: block.id
  assign delivery_popover_id = delivery_block_id | append: '-popover'
  assign delivery_days = product.metafields.custom.delivery_days.value | default: settings.default_delivery_days
  assign delivery_warehouse = product.metafields.custom.delivery_warehouse.value | default: 'default'
-%}

<div
  id="{{ delivery_block_id }}"
  class="product-delivery-info product-detail__gap-sm"
  style="
    --delivery-info-bg: {{ settings.delivery_box_bg_color }};
    --delivery-step-bg: {{ settings.delivery_step_bg_color }};
    --delivery-accent: {{ block.settings.accent_color }};
    --delivery-progress: {{ block.settings.progress_color }};
  "
  data-delivery-info
  {{ block.shopify_attributes }}
>
  <div class="product-delivery-info__summary">
    <div class="product-delivery-info__summary-row">
      <img
        class="product-delivery-info__flag"
        data-country-flag
        width="24"
        height="18"
        alt=""
        aria-hidden="true"
      >
      <span>Shipping to <strong>{{ localization.country.name }}</strong></span>
    </div>

    <div class="product-delivery-info__summary-row">
      <svg class="product-delivery-info__summary-icon" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M3 7h11v9H3V7ZM14 10h3.5l3.5 3.5V16h-7v-6Z"></path>
        <circle cx="6.5" cy="17.5" r="1.5"></circle>
        <circle cx="17.5" cy="17.5" r="1.5"></circle>
        <path d="M1 10h4M1 13h3"></path>
      </svg>

      <span class="product-delivery-info__summary-copy">
        Order today and get it by:
        <span class="product-delivery-info__popover-anchor" data-popover-anchor>
          <button
            class="product-delivery-info__trigger"
            type="button"
            aria-expanded="false"
            aria-controls="{{ delivery_popover_id }}"
            data-popover-trigger
          >
            <span data-delivery-start>Calculating…</span> – <span data-delivery-end>Calculating…</span>
          </button>

          <span
            id="{{ delivery_popover_id }}"
            class="product-delivery-info__popover"
            role="dialog"
            aria-label="Full delivery information"
            data-delivery-popover
          >
            <span class="product-delivery-info__full-copy">
              Shipping to
              <img
                class="product-delivery-info__flag"
                data-country-flag
                width="24"
                height="18"
                alt=""
                aria-hidden="true"
              >
              <strong>{{ localization.country.name }}</strong><br>

              Order within the next <strong data-countdown></strong> for dispatch today, and you'll receive your package between
              <strong><span data-delivery-start></span></strong> and <strong><span data-delivery-end></span></strong>.

              <span class="product-delivery-info__fast-shipping">
                Expect your order at your door in just <strong>5–7 business days</strong> with our <strong>Fast Shipping</strong> option. Not included production time
              </span>
            </span>

            <span class="product-delivery-info__timeline">
              <span class="product-delivery-info__progress" aria-hidden="true"></span>

              <span class="product-delivery-info__step">
                <span class="product-delivery-info__node" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" xmlns="http://www.w3.org/2000/svg">
                    <path d="M5.5 8.5h13l1 11h-15l1-11Z"></path>
                    <path d="M8.5 8.5V6.75a3.5 3.5 0 0 1 7 0V8.5"></path>
                  </svg>
                </span>
                <strong class="product-delivery-info__date" data-date-ordered></strong>
                <span class="product-delivery-info__status">{{ settings.label_ordered | default: 'Ordered' }}</span>
              </span>

              <span class="product-delivery-info__step">
                <span class="product-delivery-info__node" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" xmlns="http://www.w3.org/2000/svg">
                    <path d="M2.5 6.5h12v10h-12v-10ZM14.5 10h3l3 3.5v3h-6V10Z"></path>
                    <circle cx="6" cy="18" r="1.75"></circle>
                    <circle cx="17.5" cy="18" r="1.75"></circle>
                  </svg>
                </span>
                <strong class="product-delivery-info__date" data-date-ready></strong>
                <span class="product-delivery-info__status">{{ settings.label_ready | default: 'Order Ready' }}</span>
              </span>

              <span class="product-delivery-info__step">
                <span class="product-delivery-info__node" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 21s6-6.25 6-12a6 6 0 1 0-12 0c0 5.75 6 12 6 12Z"></path>
                    <circle cx="12" cy="9" r="2"></circle>
                  </svg>
                </span>
                <strong class="product-delivery-info__date" data-date-delivered></strong>
                <span class="product-delivery-info__status">{{ settings.label_delivered | default: 'Delivered' }}</span>
              </span>
            </span>
          </span>
        </span>
      </span>
    </div>
  </div>
</div>

{% style %}
  #{{ delivery_block_id }} {
    position: relative;
    width: 100%;
    color: inherit;
    font-size: 15px;
    text-align: left;
  }

  #{{ delivery_block_id }} .product-delivery-info__summary {
    padding: 13px 14px;
    border: 1px solid rgba(128, 128, 128, 0.28);
    border-radius: 0;
    background: var(--delivery-info-bg);
  }

  #{{ delivery_block_id }} .product-delivery-info__summary-row {
    display: flex;
    align-items: center;
    gap: 9px;
    line-height: 1.45;
  }

  #{{ delivery_block_id }} .product-delivery-info__summary-row + .product-delivery-info__summary-row {
    margin-top: 12px;
  }

  #{{ delivery_block_id }} .product-delivery-info__flag {
    display: inline-block !important;
    flex: 0 0 auto;
    width: 24px !important;
    height: 18px !important;
    border: 1px solid rgba(128, 128, 128, 0.35);
    border-radius: 0 !important;
    object-fit: fill;
    box-shadow: none !important;
    clip-path: none !important;
    filter: none !important;
    transform: none !important;
  }

  #{{ delivery_block_id }} .product-delivery-info__summary-icon {
    flex: 0 0 auto;
  }

  #{{ delivery_block_id }} .product-delivery-info__summary-icon,
  #{{ delivery_block_id }} .product-delivery-info__node svg,
  #{{ delivery_block_id }} .product-delivery-info__summary-icon *,
  #{{ delivery_block_id }} .product-delivery-info__node svg * {
    fill: none !important;
    stroke: currentColor !important;
  }

  #{{ delivery_block_id }} .product-delivery-info__summary-copy {
    min-width: 0;
  }

  #{{ delivery_block_id }} .product-delivery-info__popover-anchor {
    display: inline;
  }

  #{{ delivery_block_id }} .product-delivery-info__trigger {
    appearance: none;
    margin: 0;
    padding: 0;
    border: 0;
    border-bottom: 1px dashed currentColor;
    border-radius: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-weight: 700;
    line-height: inherit;
    cursor: help;
  }

  #{{ delivery_block_id }} .product-delivery-info__trigger:focus-visible {
    outline: 2px solid var(--delivery-accent);
    outline-offset: 3px;
  }

  #{{ delivery_block_id }} .product-delivery-info__popover {
    position: absolute;
    z-index: 30;
    top: calc(100% + 8px);
    right: 0;
    display: block;
    visibility: hidden;
    width: min(540px, calc(100vw - 40px));
    padding: 20px;
    border: 1px solid rgba(128, 128, 128, 0.28);
    border-radius: 0;
    background: var(--delivery-info-bg);
    color: inherit;
    opacity: 0;
    pointer-events: none;
    transform: translateY(4px);
    transition: opacity 150ms ease, transform 150ms ease, visibility 150ms ease;
  }

  #{{ delivery_block_id }} .product-delivery-info__popover::before {
    position: absolute;
    right: 0;
    bottom: 100%;
    left: 0;
    height: 10px;
    content: '';
  }

  #{{ delivery_block_id }} .product-delivery-info__popover-anchor:hover .product-delivery-info__popover,
  #{{ delivery_block_id }} .product-delivery-info__popover-anchor:focus-within .product-delivery-info__popover,
  #{{ delivery_block_id }} .product-delivery-info__popover-anchor.is-open .product-delivery-info__popover {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  #{{ delivery_block_id }} .product-delivery-info__full-copy {
    display: block;
    margin-bottom: 18px;
    line-height: 1.6;
  }

  #{{ delivery_block_id }} .product-delivery-info__full-copy .product-delivery-info__flag {
    margin: 0 3px;
    vertical-align: middle;
  }

  #{{ delivery_block_id }} .product-delivery-info__fast-shipping {
    display: block;
    margin-top: 14px;
  }

  #{{ delivery_block_id }} .product-delivery-info__timeline {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  #{{ delivery_block_id }} .product-delivery-info__progress {
    position: absolute;
    z-index: 0;
    top: 17px;
    right: 12%;
    left: 12%;
    height: 2px;
    background: var(--delivery-progress);
  }

  #{{ delivery_block_id }} .product-delivery-info__step {
    position: relative;
    z-index: 1;
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  #{{ delivery_block_id }} .product-delivery-info__node {
    display: grid;
    width: 34px;
    height: 34px;
    margin-bottom: 11px;
    border-radius: 0;
    background: var(--delivery-step-bg);
    place-items: center;
  }

  #{{ delivery_block_id }} .product-delivery-info__date {
    font-size: 13px;
    line-height: 1.35;
  }

  #{{ delivery_block_id }} .product-delivery-info__status {
    margin-top: 5px;
    border-bottom: 1px dashed currentColor;
    color: var(--delivery-accent);
    font-size: 13px;
    line-height: 1.35;
  }

  @media (max-width: 540px) {
    #{{ delivery_block_id }} .product-delivery-info__popover {
      right: auto;
      left: 0;
      width: 100%;
      padding: 15px;
    }

    #{{ delivery_block_id }} .product-delivery-info__timeline {
      gap: 5px;
    }

    #{{ delivery_block_id }} .product-delivery-info__date,
    #{{ delivery_block_id }} .product-delivery-info__status {
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ delivery_block_id }} .product-delivery-info__popover {
      transition: none;
    }
  }
{% endstyle %}

<script>
  (() => {
    const root = document.getElementById({{ delivery_block_id | json }});

    if (!root) return;

    if (root.deliveryCountdownTimer) {
      window.clearInterval(root.deliveryCountdownTimer);
    }

    if (root.deliveryPopoverController) {
      root.deliveryPopoverController.abort();
    }

    const controller = new AbortController();
    const { signal } = controller;
    root.deliveryPopoverController = controller;

    const find = (selector) => root.querySelector(selector);
    const findAll = (selector) => root.querySelectorAll(selector);
    const countryCode = {{ localization.country.iso_code | json }};
    const anchor = find('[data-popover-anchor]');
    const trigger = find('[data-popover-trigger]');

    if (countryCode) {
      findAll('[data-country-flag]').forEach((flagElement) => {
        flagElement.src = `https://flagcdn.com/24x18/${countryCode.toLowerCase()}.png`;
      });
    }

    const dispatchHour = {{ settings.dispatch_hour | default: 10 | json }};
    const dispatchMinute = {{ settings.dispatch_minute | default: 0 | json }};
    const dispatchDays = {{ settings.dispatch_days | default: 1 | json }};
    const excludeWeekends = {{ settings.exclude_weekends | json }};
    const deliveryRaw = {{ delivery_days | json }};
    const warehouse = {{ delivery_warehouse | json }};
    const holidayRaw = {{ settings.holiday_exceptions | json }};
    const holidays = (holidayRaw || '')
      .split(/\r?\n/)
      .map((date) => date.trim())
      .filter(Boolean)
      .map((date) => new Date(`${date}T00:00:00`));

    const bufferMap = { HN: 0, HCM: 1, USA: 5, default: 0 };
    const buffer = bufferMap[warehouse] || 0;
    const cutoff = new Date();
    cutoff.setHours(dispatchHour, dispatchMinute, 0, 0);

    function parseRange(value) {
      const normalizedValue = String(value || '0');

      if (normalizedValue.includes('|')) {
        const [min, max] = normalizedValue.split('|').map(Number);
        return { min, max };
      }

      const days = parseInt(normalizedValue, 10);
      return { min: days, max: days };
    }

    function isHoliday(date) {
      return (excludeWeekends && (date.getDay() === 0 || date.getDay() === 6)) ||
        holidays.some((holiday) =>
          holiday.getFullYear() === date.getFullYear() &&
          holiday.getMonth() === date.getMonth() &&
          holiday.getDate() === date.getDate()
        );
    }

    function addBusinessDays(start, days) {
      let count = 0;
      const date = new Date(start);

      while (count < days) {
        date.setDate(date.getDate() + 1);
        if (!isHoliday(date)) count += 1;
      }

      return date;
    }

    function renderDates() {
      const now = new Date();
      const baseDate = now > cutoff ? addBusinessDays(now, 1) : now;
      const deliveryRange = parseRange(deliveryRaw);
      const orderReadyMin = addBusinessDays(baseDate, dispatchDays);
      const orderReadyMax = addBusinessDays(baseDate, dispatchDays + 2);
      const deliveryStart = addBusinessDays(baseDate, dispatchDays + deliveryRange.min + buffer);
      const deliveryEnd = addBusinessDays(baseDate, dispatchDays + deliveryRange.max + buffer);
      const format = (date) => date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      findAll('[data-delivery-start]').forEach((element) => {
        element.textContent = format(deliveryStart);
      });
      findAll('[data-delivery-end]').forEach((element) => {
        element.textContent = format(deliveryEnd);
      });
      find('[data-date-ordered]').textContent = format(now);
      find('[data-date-ready]').textContent = `${format(orderReadyMin)} – ${format(orderReadyMax)}`;
      find('[data-date-delivered]').textContent = `${format(deliveryStart)} – ${format(deliveryEnd)}`;
    }

    function updateCountdown() {
      const countdownElements = findAll('[data-countdown]');

      function tick() {
        const difference = cutoff - new Date();

        if (difference <= 0) {
          countdownElements.forEach((element) => {
            element.textContent = 'Orders placed now will be processed tomorrow';
          });
          window.clearInterval(root.deliveryCountdownTimer);
          return;
        }

        const hours = String(Math.floor(difference / 3600000)).padStart(2, '0');
        const minutes = String(Math.floor((difference % 3600000) / 60000)).padStart(2, '0');
        const seconds = String(Math.floor((difference % 60000) / 1000)).padStart(2, '0');
        const countdown = `${hours}h ${minutes}m ${seconds}s`;

        countdownElements.forEach((element) => {
          element.textContent = countdown;
        });
      }

      tick();
      if (cutoff > new Date()) {
        root.deliveryCountdownTimer = window.setInterval(tick, 1000);
      }
    }

    function setPopoverOpen(isOpen) {
      anchor.classList.toggle('is-open', isOpen);
      trigger.setAttribute('aria-expanded', String(isOpen));
    }

    trigger.addEventListener('click', (event) => {
      event.stopPropagation();
      const shouldOpen = !anchor.classList.contains('is-open');
      setPopoverOpen(shouldOpen);
      if (!shouldOpen) trigger.blur();
    }, { signal });

    anchor.addEventListener('mouseenter', () => {
      trigger.setAttribute('aria-expanded', 'true');
    }, { signal });

    anchor.addEventListener('mouseleave', () => {
      if (!anchor.classList.contains('is-open')) {
        trigger.setAttribute('aria-expanded', 'false');
      }
    }, { signal });

    anchor.addEventListener('focusin', () => {
      trigger.setAttribute('aria-expanded', 'true');
    }, { signal });

    anchor.addEventListener('focusout', (event) => {
      if (!anchor.contains(event.relatedTarget) && !anchor.classList.contains('is-open')) {
        trigger.setAttribute('aria-expanded', 'false');
      }
    }, { signal });

    root.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setPopoverOpen(false);
        trigger.blur();
      }
    }, { signal });

    document.addEventListener('pointerdown', (event) => {
      if (!anchor.contains(event.target)) {
        setPopoverOpen(false);
      }
    }, { signal });

    document.addEventListener('shopify:section:unload', (event) => {
      if (event.detail.sectionId === {{ section.id | json }}) {
        window.clearInterval(root.deliveryCountdownTimer);
        controller.abort();
      }
    }, { signal });

    renderDates();
    updateCountdown();
  })();
</script>
