<article class="helios-blog-banner" data-cc-animate="fade-up">
  <a href="{{ article.url }}" class="banner__image-link" aria-label="{{ article.title | escape }}">
    {% if article.image %}
      {{
        article.image
        | image_url: width: 2000
        | image_tag:
          widths: '600, 900, 1200, 1600, 2000',
          sizes: '100vw',
          loading: 'lazy',
          class: 'banner__image',
          alt: article.title
      }}
    {% endif %}
  </a>

  <div class="banner__content">
    <h2 class="banner__title--small">
      <a href="{{ article.url }}">{{ article.title }}</a>
    </h2>
    <div class="banner__highlight">
      {{ article.metafields.custom.highlight | default: article.excerpt_or_content | strip_html | truncatewords: 20 }}
    </div>
    <a href="{{ article.url }}" class="banner__link">{{ 'blogs.article.read_more' | t }}</a>
  </div>
</article>
